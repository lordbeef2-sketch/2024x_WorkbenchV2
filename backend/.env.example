# Created by: Raymond Reeves Engineering Tech 4 2026
# TWC Workbench minimal bootstrap configuration
#
# Normal administration belongs in Workbench Settings after first login:
# - TWC server presets
# - user-management mode: Workbench local users or TWC users
# - local Workbench users and password resets
# - plugin ingest token and cache API keys
#
# Advanced environment overrides still exist for deployments that need them;
# see README.md and backend/README.md. Keep this file small on purpose.

APP_NAME=TWC Workbench
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Storage
DATA_DIR=./data
DATABASE_PATH=

# Required for non-local deployments. The offline installer auto-generates this.
SESSION_SECRET=replace-with-a-32-byte-secret
SECURE_COOKIES=false

# First local-mode bootstrap login when no Workbench users exist.
# Defaults are intentionally simple for first access. Rotate immediately in
# Workbench Settings after login.
WORKBENCH_DEFAULT_ADMIN_USERNAME=admin
WORKBENCH_DEFAULT_ADMIN_PASSWORD=admin
WORKBENCH_USER_MANAGEMENT_MODE=local

# Optional seed catalog only. Once the app is running, manage servers in
# Workbench Settings. Leave empty for a clean first-run setup.
TWC_PRESET_SERVERS=[]

# Optional TWC OIDC client defaults for TWC user-management mode. These stay in
# env/secret-manager bootstrap for now because they may include a client secret.
TWC_AUTH_CLIENT_ID=
TWC_AUTH_CLIENT_SECRET=
TWC_AUTH_SCOPE=openid

# Authoritative 3DS KB and Open WebUI defaults.
THREE_DS_KB_PATH=C:/Users/Main1/Documents/NI KB base/3DS_KB
OPENWEBUI_VERIFY_TLS=true
OPENWEBUI_CA_BUNDLE_PATH=
OPENWEBUI_ALLOW_INSECURE_HTTP=false
OPENWEBUI_ALLOWED_HOSTS=[]

# Fully-commented edition notes:
# - File path: backend/.env.example
# - This branch intentionally carries extra explanatory comments for handoff, review, and training.
# - Keep behavioral changes on main first, then rebase or regenerate this branch so comments never hide logic drift.
# - The normal main branch keeps the production-readable version with only provenance headers.